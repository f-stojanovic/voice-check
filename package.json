{
  "name": "voice-check",
  "version": "0.1.0",
  "description": "A style checker that grades prose against a writer's own rules, in Serbian and English.",
  "license": "MIT",
  "author": "Filip Stojanović",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lexicons"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx src/cli.ts",
    "brief": "tsx src/brief.ts",
    "calibrate": "tsx src/calibrate.ts",
    "corpus:generate": "tsx src/corpus-generate.ts",
    "web": "tsx src/web/server.ts",
    "eval:fixture": "tsx src/evals/smoke.eval.ts",
    "label:analyst": "tsx src/evals/analyst/label-cli.eval.ts",
    "eval:analyst": "tsx src/evals/analyst.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "agent-evals": "github:f-stojanovic/agent-evals#2e6633ee914f4e916910261a69a54b40651a3d85",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
